{
  "name": "@ecfairle/mccli",
  "version": "3.3.2",
  "description": "cli for CVD Policy Model Montecarlo simulation",
  "main": "index.js",
  "type": "commonjs",
  "jest": {
    "testMatch": [
      "**/__tests__/*.js"
    ],
    "testPathIgnorePatterns": [
      "/\\.git/",
      "/Mod92_.*/",
      "/mod92_.*/",
      "/\\.pytest_cache/",
      "/\\.vs*/",
      "/node_modules/",
      "/py_tests/",
      "/pyenv/"
    ]
  },
  "scripts": {
    "test": "jest"
  },
  "bin": {
    "mc": "bin/mc.js",
    "frmtToData": "bin/python/frmtToData.py",
    "frmtReport": "bin/python/frmtReport.py"
  },
  "author": "",
  "contributors": [
    "Ross Boylan <ross.boylan@ucsf.edu>"
  ],
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": ">=9.4.1",
    "colors": "^1.4.0",
    "fs": ">=0.0.1-security",
    "fs-extra": ">=11.2.0",
    "inquirer": ">=1.2.3 <9.0.0 || >=10",
    "n-readlines": "^1.0.3",
    "path": ">=0.12.7",
    "progress": ">=2.0.3",
    "shelljs": ">=0.8.5",
    "single-line-log": ">=1.1.2",
    "yargs": ">=17.7.2"
  },
  "maintainers": [
    {
      "name": "ecfairle",
      "email": "ecfairley@ucdavis.edu"
    },
    {
      "name": "Ross Boylan",
      "email": "ross.boylan@ucsf.edu"
    }
  ],
  "keywords": [
    "monte-carlo",
    "CVD",
    "health policy",
    "python"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "jest": "^29.7.0"
  }
}
